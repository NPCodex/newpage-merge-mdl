// Win32 version resource - generated by CMake from the project version.
@SUBTOOL_UTF8_MANIFEST_RESOURCE@
1 VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS         0x4L        // VOS__WINDOWS32
FILETYPE       0x1L        // VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"   // US English, Unicode
        {
            VALUE "FileDescription",  "L4D2 survivor $declaresequence swap generator"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "l4d_animswap"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Toppi"
            VALUE "OriginalFilename", "l4d_animswap.exe"
            VALUE "ProductName",      "NewPageMergeMDL"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
