// Win32 version resource - generated by CMake from the project version.
1 VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
FILEOS         0x4L        // VOS__WINDOWS32
FILETYPE       0x1L        // VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"   // US English, Unicode
        {
            VALUE "FileDescription",  "Source model compiler (.pulseqc -> .mdl)"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "NewPageMergeMDL"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Toppi"
            VALUE "OriginalFilename", "NewPageMergeMDL.exe"
            VALUE "ProductName",      "NewPageMergeMDL"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
