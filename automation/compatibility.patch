+  const VertexIndex new_vi = ct->AddNewVertex();
+  ASSERT_EQ(ct->num_vertices(), 9);
+
+  ASSERT_EQ(ct->AddNewFace({VertexIndex(6), VertexIndex(7), new_vi}), 12);
+  ASSERT_EQ(ct->num_faces(), 13);
+  ASSERT_EQ(ct->num_corners(), 3 * 13);
