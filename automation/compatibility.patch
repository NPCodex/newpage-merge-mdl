+bool GltfAsset::PadBuffer() {
+  if (buffer_.size() % 4 != 0) {
+    const int pad_bytes = 4 - buffer_.size() % 4;
+    const int pad_data = 0;
+    if (!buffer_.Encode(&pad_data, pad_bytes)) {
+      return false;
+    }
+  }
+  return true;
+}
