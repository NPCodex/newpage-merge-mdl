+/// Ogre Skeleton
+class Skeleton
+{
+public:
+    enum BlendMode
+    {
+        /// Animations are applied by calculating a weighted average of all animations
+        ANIMBLEND_AVERAGE = 0,
+        /// Animations are applied by calculating a weighted cumulative total
+        ANIMBLEND_CUMULATIVE = 1
