+                break;
+            clause = c.toks[c.pos++];
+            if (!c.Eof() && !c.Cur().quoted && Lower(c.Cur().text) == "if") {
+                clause = c.toks[c.pos++];
+                continue;
+            }
+            if (!ExpectBrace(c, clause) || !CollectBlock(c, clause, body))
+                return false;
+            if (!taken) chosen = std::move(body);
+            break;
+        }
+        return true;
+    };
+    const bool ok = parse();
+    c.rawCollect = savedRaw;
+    if (ok) c.SpliceAt(c.pos, chosen);
+    return ok;
+}
 bool CmdIfdef(Ctx& c, const Token& cmd) { return IfChain(c, cmd, true); }
 bool CmdIfndef(Ctx& c, const Token& cmd) { return IfChain(c, cmd, true, /*negate=*/true); }
 
