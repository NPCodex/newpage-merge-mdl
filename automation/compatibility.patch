+// Read a half-life 2 MDL
+void MDLImporter::InternReadFile_HL2() {
+    //const MDL::Header_HL2* pcHeader = (const MDL::Header_HL2*)this->mBuffer;
+    throw DeadlyImportError("HL2 MDLs are not implemented");
+}
