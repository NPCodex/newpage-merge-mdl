+/** @file  3DSLoader.cpp
+ *  @brief Implementation of the 3ds importer class
+ *
+ *  http://www.the-labs.com/Blender/3DS-details.html
+ */
+
+#ifndef ASSIMP_BUILD_NO_3DS_IMPORTER
+
