+aiNodeAnim *FBXConverter::GenerateTranslationNodeAnim(const std::string &name,
+        const Model & /*target*/,
+        const std::vector<const AnimationCurveNode *> &curves,
+        const LayerMap &layer_map,
+        int64_t start, int64_t stop,
+        double &max_time,
+        double &min_time,
+        bool inverse) {
