index 0000000..7b9432f
--- /dev/null
+++ b/libs/assimp/contrib/poly2tri/poly2tri/sweep/sweep_context.cc
@@ -0,0 +1,206 @@
+/*
+ * Poly2Tri Copyright (c) 2009-2022, Poly2Tri Contributors
+ * https://github.com/jhasse/poly2tri
