+namespace Assimp {
+
+namespace {
+
+static constexpr aiImporterDesc desc = {
+    "Stereolithography (STL) Importer",
+    "",
+    "",
+    "",
+    aiImporterFlags_SupportTextFlavour | aiImporterFlags_SupportBinaryFlavour,
+    0,
+    0,
