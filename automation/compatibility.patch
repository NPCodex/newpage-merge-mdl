+                               Vector3f(1.f, 1.f, 0.f).data(),
+                               Vector3f(1.f, 0.f, 1.f).data(),
+                               Vector3f(1.f, 1.f, 1.f).data());
+
+  // Left face.
+  mb.SetAttributeValuesForFace(pos_att_id, FaceIndex(10),
+                               Vector3f(0.f, 1.f, 0.f).data(),
+                               Vector3f(0.f, 0.f, 1.f).data(),
