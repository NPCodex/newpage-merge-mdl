+    void ReadPoses(Mesh *mesh);
+    void ReadPoseVertices(Pose *pose);
+
+    void ReadAnimations(Mesh *mesh);
+    void ReadAnimation(Animation *anim);
+    void ReadAnimationKeyFrames(Animation *anim, VertexAnimationTrack *track);
+
