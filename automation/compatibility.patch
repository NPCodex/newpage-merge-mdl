+  }
+  if (att->data_type() == DT_UINT16) {
+    return AddAttribute<uint16_t>(*att, mesh.num_points(), num_encoded_points,
+                                  mesh.IsCompressionEnabled());
+  }
+  return AddAttribute<uint8_t>(*att, mesh.num_points(), num_encoded_points,
+                               mesh.IsCompressionEnabled());
+}
