+/** @file  ZipArchiveIOSystem.cpp
+ *  @brief Zip File I/O implementation for #Importer
+ */
+
+#include <assimp/BaseImporter.h>
+#include <assimp/ZipArchiveIOSystem.h>
+
+#include <assimp/ai_assert.h>
+
+#include <map>
