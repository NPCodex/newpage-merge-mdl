+    target_compile_definitions(openddlparser_unittest PRIVATE OPENDDL_TEST_DATA="${PROJECT_SOURCE_DIR}/test/TestData")
+endif ()
+
+if (DDL_BUILD_PARSER_DEMO)
+    SET( openddlparser_demo_src
+        demo/main.cpp
+    )
