+  // Back face.
+  mb.SetAttributeValuesForFace(pos_att_id, FaceIndex(2),
+                               Vector3f(0.f, 1.f, 1.f).data(),
+                               Vector3f(1.f, 0.f, 1.f).data(),
+                               Vector3f(0.f, 0.f, 1.f).data());
+  mb.SetAttributeValuesForFace(pos_att_id, FaceIndex(3),
