+/** @file  COBLoader.cpp
+ *  @brief Implementation of the TrueSpace COB/SCN importer class.
+ */
+
+#ifndef ASSIMP_BUILD_NO_COB_IMPORTER
+
+#include "COBLoader.h"
+#include "COBScene.h"
+#include "PostProcessing/ConvertToLHProcess.h"
