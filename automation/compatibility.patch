+    na->mNodeName.Set(name);
+
+    ConvertTranslationKeys(na.get(), curves, layer_map, start, stop, max_time, min_time);
+
+    if (inverse) {
+        for (unsigned int i = 0; i < na->mNumPositionKeys; ++i) {
