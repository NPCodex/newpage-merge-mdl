+    //! 4*3
+    float   m [4*4];
+
+    //! the index of this vertex, 0.. header::bones_num - 1
+    uint16_t bone_index;
+
+    //! I HATE 3DGS AND THE SILLY DEVELOPER WHO DESIGNED
+    //! THIS STUPID FILE FORMAT!
+    int8_t _unused_[2];
+} PACK_STRUCT;
+
+
+#define AI_MDL7_MAX_FRAMENAMESIZE       16
