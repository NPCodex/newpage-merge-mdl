+  ASSERT_NE(sampler, nullptr);
+  ASSERT_EQ(sampler->input_index, 0);
+  ASSERT_EQ(sampler->interpolation_type,
+            AnimationSampler::SamplerInterpolation::LINEAR);
+  ASSERT_EQ(sampler->output_index, 1);
