+
+TEST(FileWriterUtilsTest, SplitPathPrivateNonWindows) {
+  const std::string test_path = "/path/to/file";
+  std::string directory;
+  std::string file;
+  SplitPathPrivate(test_path, &directory, &file);
+  ASSERT_EQ(directory, "/path/to");
