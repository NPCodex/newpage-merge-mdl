+  for (MeshInstanceIndex i(0); i < instances.size(); i++) {
+    const MeshInstance &instance = instances[i];
+    const Mesh &mesh = scene.GetMesh(instance.mesh_index);
+    const PointAttribute *att = mesh.GetNamedAttribute(att_type);
