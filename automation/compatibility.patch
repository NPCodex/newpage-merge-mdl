+  const std::string test_path = "C:\\path\\to\\file";
+  std::string directory;
+  std::string file;
+  SplitPathPrivate(test_path, &directory, &file);
+  ASSERT_EQ(directory, "C:\\path\\to");
+  ASSERT_EQ(file, "file");
+}
