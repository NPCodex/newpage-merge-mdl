+void Mesh::Copy(const Mesh &src) {
+  PointCloud::Copy(src);
+  name_ = src.name_;
+  faces_ = src.faces_;
+  attribute_data_ = src.attribute_data_;
+  material_library_.Copy(src.material_library_);
