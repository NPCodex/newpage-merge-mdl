+// ------------------------------------------------------------------------------------------------
+TokenPtr Parser::AdvanceToNextToken()
+{
+    last = current;
+    if (cursor == tokens.end()) {
+        current = nullptr;
+    } else {
+        current = *cursor++;
+    }
+    return current;
+}
