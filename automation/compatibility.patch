+  ASSERT_EQ(ct->Vertex(CornerIndex(3 * 12 + 0)), 6);
+  ASSERT_EQ(ct->Vertex(CornerIndex(3 * 12) + 1), 7);
+  ASSERT_EQ(ct->Vertex(CornerIndex(3 * 12) + 2), new_vi);
+}
