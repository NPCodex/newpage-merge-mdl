+    AddChild(n);
+}
+
+void FBX::Node::AddP70vectorA(
+        const std::string &cur_name, double x, double y, double z) {
+    FBX::Node n("P");
+    n.AddProperties(cur_name, "Vector", "", "A", x, y, z);
