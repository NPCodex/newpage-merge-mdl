+/** @file Implementation of the MDL importer class */
+
+#ifndef ASSIMP_BUILD_NO_HMP_IMPORTER
+
+// internal headers
+#include "HMPLoader.h"
+#include "AssetLib/MD2/MD2FileData.h"
+
+#include <assimp/StringUtils.h>
+#include <assimp/importerdesc.h>
+#include <assimp/scene.h>
