+
+    // create RGBA array from RGB.
+    for (std::list<aiColor3D>::const_iterator it = pColors.begin(); it != pColors.end(); ++it) {
+        tcol.emplace_back((*it).r, (*it).g, (*it).b, static_cast<ai_real>(1));
