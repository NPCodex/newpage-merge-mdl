+//------------------------------------------------------------------------------------------------
+void OpenGEXImporter::handleGeometryNode(DDLNode *node, aiScene *pScene) {
+    aiNode *newNode = new aiNode;
+    pushNode(newNode, pScene);
+    m_tokenType = Grammar::GeometryNodeToken;
+    m_currentNode = newNode;
+    handleNodes(node, pScene);
+
+    popNode();
+}
