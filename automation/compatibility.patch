+TEST_F(TriangleSoupMeshBuilderTest, CubeTest) {
+  // This tests, verifies that the mesh builder constructs a valid cube out
+  // of the provided triangle soup data.
+  TriangleSoupMeshBuilder mb;
+  mb.Start(12);
