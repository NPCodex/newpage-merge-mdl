+void CompareVectorArray(const std::array<Vector3f, 3> &a,
+                        const std::array<Vector3f, 3> &b) {
+  for (int v = 0; v < 3; ++v) {
+    for (int c = 0; c < 3; ++c) {
+      EXPECT_FLOAT_EQ(a[v][c], b[v][c]) << "v:" << v << " c:" << c;
+    }
+  }
+}
